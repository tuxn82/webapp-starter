<%- include('../partials/header') %>
<div class="card">
  <h1>Skift adgangskode</h1>
  <% if (currentUser.must_change_password) { %>
    <div class="alert info">Du skal vælge en ny adgangskode, før du kan fortsætte.</div>
  <% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nuværende adgangskode
      <input type="password" name="current_password" autocomplete="current-password" required>
    </label>
    <label>Ny adgangskode <span class="muted">(mindst 12 tegn)</span>
      <input type="password" name="new_password" autocomplete="new-password" minlength="12" required>
    </label>
    <label>Gentag ny adgangskode
      <input type="password" name="confirm_password" autocomplete="new-password" minlength="12" required>
    </label>
    <button type="submit">Gem</button>
  </form>
  <% if (currentUser.must_change_password) { %>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Log ud</button>
    </form>
  <% } %>
</div>
<%- include('../partials/footer') %>
