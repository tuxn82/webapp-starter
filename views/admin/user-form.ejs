<%- include('../partials/header') %>
<p><a href="/admin/users">&larr; Tilbage til brugere</a></p>
<div class="card wide">
  <h1><%= title %></h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="<%= editing ? '/admin/users/' + editing.id : '/admin/users' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Navn
      <input type="text" name="name" value="<%= form.name %>" maxlength="200" required>
    </label>
    <label>E-mail
      <input type="email" name="email" value="<%= form.email %>" required>
    </label>
    <label>Rolle
      <select name="role">
        <option value="user" <%= form.role === 'user' ? 'selected' : '' %>>Bruger</option>
        <option value="admin" <%= form.role === 'admin' ? 'selected' : '' %>>Administrator</option>
      </select>
    </label>
    <% if (editing) { %>
      <label class="check">
        <input type="checkbox" name="active" <%= form.active ? 'checked' : '' %>> Aktiv (kan logge ind)
      </label>
    <% } else { %>
      <input type="hidden" name="active" value="on">
      <label>Midlertidig adgangskode <span class="muted">(valgfri, lad stå tom for at generere en)</span>
        <input type="text" name="password" minlength="12" autocomplete="off">
      </label>
      <p class="muted">Brugeren skal vælge sin egen adgangskode ved første login.</p>
    <% } %>
    <button type="submit"><%= editing ? 'Gem ændringer' : 'Opret bruger' %></button>
  </form>
</div>

<% if (editing && editing.id !== currentUser.id) { %>
<div class="card wide">
  <h2>Nulstil adgangskode</h2>
  <p class="muted">Genererer en ny midlertidig adgangskode og logger brugeren ud alle steder.</p>
  <form method="post" action="/admin/users/<%= editing.id %>/reset-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="secondary">Nulstil adgangskode</button>
  </form>
</div>
<% } %>
<%- include('../partials/footer') %>
