<%- include('../partials/header') %>
<div class="card wide">
  <h1><%= heading %></h1>
  <p><strong><%= user.name %></strong> (<%= user.email %>)</p>
  <p>Midlertidig adgangskode:</p>
  <p class="secret"><code><%= password %></code></p>
  <div class="alert info">
    Adgangskoden vises kun denne ene gang. Giv den til brugeren ad en sikker vej
    (f.eks. mundtligt eller i en separat besked). Brugeren skal vælge en ny ved første login.
  </div>
  <p><a class="button" href="/admin/users">Tilbage til brugere</a></p>
</div>
<%- include('../partials/footer') %>
